# ==============================================================================
# TriRoute — environment configuration
# Copy to config/.env, then `chmod 600 config/.env`. install.sh does this for you.
# NEVER commit the real .env.
# ==============================================================================

# --- Gateway ports (loopback-only bindings are enforced in compose.yaml) ---
PORT=3737
LITELLM_PORT=4000

# --- Master key (REQUIRED) ---
# Generate with: openssl rand -hex 32
# The gateway refuses to start if this is unset or matches a known upstream
# default (TG-004 fallback keys are explicitly rejected).
LITELLM_MASTER_KEY=

# Random dashboard API key, generated by install.sh. The browser receives it
# as a same-origin HttpOnly cookie; desktop/automation may send it as Bearer.
DASHBOARD_API_KEY=

# --- OAuth public client IDs (first-party CLI clients; safe defaults shipped) ---
ANTHROPIC_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e
OPENAI_CODEX_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
GOOGLE_CLIENT_ID=1071006060591-tmhssin2h21lcre235vtolojh4g403ep.apps.googleusercontent.com

# Google's token endpoint requires this paired "installed app" secret for the
# exchange. It is a public client secret embedded in shipped binaries, but it
# is not present in this repository — set it here before authenticating Google.
GOOGLE_CLIENT_SECRET=
